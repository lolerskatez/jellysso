<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= csrfToken || '' %>">
  <title>User Expiry Management - JellySSO Admin</title>
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/layout.css">
  <link rel="stylesheet" href="/css/fontawesome.css">
  <style>
    .page-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: var(--spacing-2xl);
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: var(--spacing-lg);
      margin-bottom: var(--spacing-2xl);
    }

    .stat-card {
      background: var(--bg-primary);
      border: 1px solid var(--border-color);
      border-radius: var(--border-radius);
      padding: var(--spacing-lg);
      text-align: center;
    }

    .stat-value {
      font-size: 2rem;
      font-weight: 700;
      color: var(--primary);
      margin: 0;
    }

    .stat-label {
      font-size: 0.9rem;
      color: var(--text-secondary);
      margin: 5px 0 0 0;
    }

    .tabs {
      display: flex;
      gap: var(--spacing-md);
      margin-bottom: var(--spacing-xl);
      border-bottom: 2px solid var(--border-color);
    }

    .tab {
      padding: var(--spacing-md) var(--spacing-lg);
      cursor: pointer;
      border: none;
      background: none;
      font-size: 1rem;
      font-weight: 600;
      color: var(--text-secondary);
      border-bottom: 3px solid transparent;
      transition: all 0.2s;
    }

    .tab.active {
      color: var(--primary);
      border-bottom-color: var(--primary);
    }

    .tab-content {
      display: none;
    }

    .tab-content.active {
      display: block;
    }

    .users-table {
      width: 100%;
      border-collapse: collapse;
      border: 1px solid var(--border-color);
      border-radius: var(--border-radius);
      overflow: hidden;
    }

    .users-table th {
      background: var(--bg-light);
      padding: var(--spacing-md);
      text-align: left;
      font-weight: 600;
      color: var(--text-primary);
      border-bottom: 2px solid var(--border-color);
    }

    .users-table td {
      padding: var(--spacing-md);
      border-bottom: 1px solid var(--border-color);
    }

    .users-table tbody tr:hover {
      background: var(--bg-light);
    }

    .days-remaining {
      font-weight: 600;
      color: var(--warning);
    }

    .days-remaining.critical {
      color: var(--danger);
    }

    .btn-small {
      padding: 6px 12px;
      font-size: 0.9rem;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      font-weight: 600;
    }

    .btn-action {
      background: var(--primary);
      color: white;
    }

    .btn-danger {
      background: #ef4444;
      color: white;
    }

    .alert {
      padding: var(--spacing-lg);
      border-radius: var(--border-radius);
      margin-bottom: var(--spacing-lg);
    }

    .alert-success {
      background: #d1fae5;
      color: #065f46;
      border-left: 4px solid #10b981;
    }

    .alert-error {
      background: #fee2e2;
      color: #991b1b;
      border-left: 4px solid #ef4444;
    }

    .empty-state {
      text-align: center;
      padding: var(--spacing-3xl) var(--spacing-lg);
      color: var(--text-secondary);
    }

    .actions-bar {
      display: flex;
      gap: var(--spacing-md);
      margin-bottom: var(--spacing-xl);
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--primary), #0066cc);
      color: white;
      padding: 10px 20px;
      border: none;
      border-radius: var(--border-radius);
      cursor: pointer;
      font-weight: 600;
      transition: opacity 0.2s;
    }

    .btn-primary:hover { opacity: 0.9; }
    .btn-primary:disabled { opacity: 0.6; cursor: not-allowed; }

    .loading {
      text-align: center;
      padding: var(--spacing-2xl);
    }

    .spinner {
      width: 40px;
      height: 40px;
      border: 4px solid var(--border-color);
      border-top-color: var(--primary);
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
      margin: 0 auto var(--spacing-lg);
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }
  </style>
</head>
<body>
  <div class="app-container">
    <%- include('../partials/navigation', { user, currentPage: 'admin-expiry' }) %>
    <main class="main-content">
      <header class="header">
        <div class="header-left">
          <button class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Toggle menu">
            <i class="fas fa-bars"></i>
          </button>
          <h1 class="header-title">User Expiry Management</h1>
        </div>
      </header>

      <div class="page-content">

    <div id="alertContainer"></div>

    <div class="stats-grid">
      <div class="stat-card">
        <p class="stat-value" id="statTotal">-</p>
        <p class="stat-label">Users with Expiry</p>
      </div>
      <div class="stat-card">
        <p class="stat-value" id="statActive">-</p>
        <p class="stat-label">Active</p>
      </div>
      <div class="stat-card">
        <p class="stat-value" id="statExpiring">-</p>
        <p class="stat-label">Expiring Soon (7 days)</p>
      </div>
      <div class="stat-card">
        <p class="stat-value" id="statExpired">-</p>
        <p class="stat-label">Expired</p>
      </div>
    </div>

    <div class="actions-bar">
      <button class="btn-primary" id="btnTriggerWarnings">
        <i class="fas fa-bell"></i> Send Expiry Warnings
      </button>
      <button class="btn-primary" id="btnTriggerDisable">
        <i class="fas fa-ban"></i> Disable Expired Users
      </button>
    </div>

    <div class="tabs">
      <button class="tab active" data-tab="expiring">
        <i class="fas fa-clock"></i> Expiring Soon
      </button>
      <button class="tab" data-tab="expired">
        <i class="fas fa-times-circle"></i> Already Expired
      </button>
      <button class="tab" data-tab="settings">
        <i class="fas fa-cog"></i> Settings
      </button>
    </div>

    <div id="expiringTab" class="tab-content active">
      <div id="expiringLoading" class="loading">
        <div class="spinner"></div>
        <p>Loading users...</p>
      </div>
      <div id="expiringContainer" style="overflow-x: auto;">
        <table class="users-table">
          <thead>
            <tr>
              <th>Username</th>
              <th>Email</th>
              <th>Expires</th>
              <th>Days Remaining</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody id="expiringTableBody">
          </tbody>
        </table>
      </div>
    </div>

    <div id="expiredTab" class="tab-content">
      <div id="expiredLoading" class="loading">
        <div class="spinner"></div>
        <p>Loading users...</p>
      </div>
      <div id="expiredContainer" style="overflow-x: auto;">
        <table class="users-table">
          <thead>
            <tr>
              <th>Username</th>
              <th>Email</th>
              <th>Expired On</th>
              <th>Days Ago</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody id="expiredTableBody">
          </tbody>
        </table>
      </div>
    </div>

    <!-- Expiry Settings Tab -->
    <div id="settingsTab" class="tab-content">
      <div style="max-width:600px;">
        <div style="background:var(--bg-primary);border:1px solid var(--border-color);border-radius:var(--border-radius);padding:var(--spacing-xl);">
          <h3 style="margin-top:0;">Expiry Behaviour Settings</h3>
          <div id="settingsAlert"></div>

          <div style="margin-bottom:var(--spacing-lg);">
            <label style="display:block;font-weight:600;margin-bottom:6px;">Warning Window (days before expiry)</label>
            <input type="number" id="expiryReminderDays" class="form-control" min="1" max="90" style="max-width:120px;">
            <small style="color:var(--text-secondary);">Send warnings this many days before account expires.</small>
          </div>

          <div style="margin-bottom:var(--spacing-lg);">
            <label style="display:block;font-weight:600;margin-bottom:6px;">On-Expiry Action</label>
            <select id="expiryAction" class="form-control">
              <option value="disable">Disable (keep account, prevent login)</option>
              <option value="delete">Delete (permanently remove account)</option>
              <option value="disable_then_delete">Disable first, then delete after grace period</option>
            </select>
          </div>

          <div id="graceDaysRow" style="margin-bottom:var(--spacing-lg);display:none;">
            <label style="display:block;font-weight:600;margin-bottom:6px;">Grace Period (days before deletion after disabling)</label>
            <input type="number" id="expiryGraceDays" class="form-control" min="0" max="365" style="max-width:120px;">
          </div>

          <button class="btn-primary" id="btnSaveExpirySettings"><i class="fas fa-save"></i> Save Settings</button>
        </div>

        <!-- Self-Service Renewal -->
        <div style="margin-top:var(--spacing-xl);background:var(--bg-primary);border:1px solid var(--border-color);border-radius:var(--border-radius);padding:var(--spacing-xl);">
          <h3 style="margin-top:0;">Self-Service Renewal</h3>
          <p style="color:var(--text-secondary);font-size:.875rem;">Allow users to request an account renewal from their account page when their account is expiring soon.</p>
          <div id="renewalAlert"></div>

          <div style="margin-bottom:var(--spacing-lg);display:flex;align-items:center;gap:12px;">
            <div class="toggle-switch" id="renewalEnabledToggle" style="cursor:pointer;"></div>
            <label for="renewalEnabledToggle" style="font-weight:600;cursor:pointer;">Enable self-service renewal requests</label>
          </div>

          <div style="margin-bottom:var(--spacing-lg);">
            <label style="display:block;font-weight:600;margin-bottom:6px;">Renewal Request Window (days before expiry)</label>
            <input type="number" id="renewalWindowDays" class="form-control" min="1" max="365" value="30" style="max-width:120px;">
            <small style="color:var(--text-secondary);">Users can request renewal when this many days or fewer remain.</small>
          </div>

          <button class="btn-primary" id="btnSaveRenewalSettings"><i class="fas fa-save"></i> Save Renewal Settings</button>
        </div>
      </div>
    </div>
  </div>
  </main>
  </div>

  <style>
    .form-control { width:100%;padding:8px 12px;border:1px solid var(--border-color);border-radius:var(--border-radius);font-size:.95rem;box-sizing:border-box;background:var(--bg-secondary,#fff);color:var(--text-primary); }
    .form-control:focus{outline:none;border-color:var(--primary);box-shadow:0 0 0 3px rgba(0,102,204,.1);}
  </style>

  <script src="/js/admin-expiry.js"></script>

  <script src="/js/mobile-nav.js"></script>
</body>
</html>
