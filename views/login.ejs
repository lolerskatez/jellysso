<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="JellySSO - Single Sign-On for Jellyfin">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title>Sign In - JellySSO</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/fontawesome.css">
  <link rel="stylesheet" href="/css/layout.css">
  <style nonce="<%= nonce %>">
    html, body {
      height: 100%;
      margin: 0;
      padding: 0;
    }

    body {
      background: var(--bg-primary);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .login-page-wrapper {
      width: 100%;
      max-width: 420px;
      padding: var(--spacing-md);
    }

    .login-card {
      background: var(--bg-primary);
      border-radius: var(--border-radius-lg);
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
      overflow: hidden;
    }

    .login-body {
      padding: var(--spacing-xl);
    }

    .login-form .form-group {
      margin-bottom: var(--spacing-lg);
    }

    .login-form .form-label {
      display: block;
      margin-bottom: var(--spacing-xs);
      font-weight: 500;
      color: var(--gray-700);
      font-size: 0.875rem;
    }

    .login-form .form-control {
      width: 100%;
      padding: var(--spacing-md);
      border: 1px solid var(--border-color);
      border-radius: var(--border-radius);
      font-size: 1rem;
      transition: all var(--transition);
      box-sizing: border-box;
    }

    .login-form .form-control:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(0, 102, 204, 0.1);
    }

    .login-form .form-control::placeholder {
      color: var(--gray-400);
    }

    .login-btn {
      width: 100%;
      padding: var(--spacing-md) var(--spacing-lg);
      background: var(--primary);
      color: white;
      border: none;
      border-radius: var(--border-radius);
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      transition: all var(--transition);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: var(--spacing-sm);
    }

    .login-btn:hover {
      background: var(--primary-dark);
      transform: translateY(-1px);
    }

    .login-btn:active {
      transform: translateY(0);
    }

    .login-btn:disabled {
      opacity: 0.7;
      cursor: not-allowed;
      transform: none;
    }

    .login-btn .spinner {
      width: 18px;
      height: 18px;
      border: 2px solid rgba(255, 255, 255, 0.3);
      border-top-color: white;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .login-options {
      display: flex;
      align-items: center;
      margin: var(--spacing-lg) 0;
      color: var(--text-secondary);
      font-size: 0.8125rem;
    }

    .login-options::before,
    .login-options::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--border-color);
    }

    .login-options span {
      padding: 0 var(--spacing-md);
    }

    .login-links {
      display: flex;
      gap: var(--spacing-sm);
    }

    .login-link {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: var(--spacing-xs);
      padding: var(--spacing-md);
      background: var(--bg-secondary);
      border: 1px solid var(--border-color);
      border-radius: var(--border-radius);
      color: var(--gray-700);
      font-size: 0.875rem;
      font-weight: 500;
      text-decoration: none;
      transition: all var(--transition);
    }

    .login-link:hover {
      background: var(--primary);
      border-color: var(--primary);
      color: white;
    }

    .login-link:hover i {
      color: white;
    }

    .login-link i {
      color: var(--primary);
      font-size: 1rem;
    }

    /* Alert Styles */
    .alert {
      display: flex;
      align-items: center;
      gap: var(--spacing-sm);
      padding: var(--spacing-md);
      border-radius: var(--border-radius);
      margin-bottom: var(--spacing-lg);
      font-size: 0.875rem;
      line-height: 1.4;
      animation: slideIn 0.3s ease;
    }

    .alert.error {
      background: rgba(239, 68, 68, 0.1);
      border: 1px solid rgba(239, 68, 68, 0.2);
      color: var(--danger);
    }

    .alert.success {
      background: rgba(16, 185, 129, 0.1);
      border: 1px solid rgba(16, 185, 129, 0.2);
      color: var(--success);
    }

    .alert i {
      flex-shrink: 0;
      display: flex;
      align-items: center;
    }

    .alert > div {
      margin: 0;
      line-height: 1.4;
    }

    @keyframes slideIn {
      from {
        opacity: 0;
        transform: translateY(-10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Responsive */
    .hidden {
      display: none;
    }

    @media (max-width: 480px) {
      .login-page-wrapper {
        max-width: 100%;
      }

      .login-body {
        padding: var(--spacing-lg);
      }

      .login-links {
        flex-direction: column;
      }
    }
  </style>
</head>
<body>
  <!-- Announcements Banner -->
  <div id="announcementsBanner" style="position: fixed; top: 0; left: 0; right: 0; background: #f0f9ff; border-bottom: 2px solid #0066cc; padding: var(--spacing-md) var(--spacing-lg); display: none; z-index: 1000; max-height: 200px; overflow-y: auto;">
    <div style="max-width: 600px; margin: 0 auto;">
      <div id="announcementsContainer"></div>
      <button id="closeAnnouncementsBtn" style="position: absolute; top: 10px; right: 10px; background: none; border: none; color: #0066cc; font-size: 1.5rem; cursor: pointer;">✕</button>
    </div>
  </div>

  <style>
    body.has-announcements {
      margin-top: 120px;
    }
  </style>

  <div class="login-page-wrapper">
    <div class="login-card">
      <div class="login-body">
        <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
          <div class="alert error">
            <i class="fas fa-exclamation-circle"></i>
            <div><%= errorMessage %></div>
          </div>
        <% } %>
        <div id="message" class="alert hidden"></div>
        
        <form id="loginForm" class="login-form" method="post" action="/api/auth/login">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          
          <div class="form-group">
            <label class="form-label" for="username">Username</label>
            <input 
              type="text" 
              id="username" 
              name="username" 
              class="form-control" 
              placeholder="Enter your Jellyfin username" 
              required
              autocomplete="username"
            >
          </div>

          <div class="form-group">
            <label class="form-label" for="password">Password</label>
            <input 
              type="password" 
              id="password" 
              name="password" 
              class="form-control" 
              placeholder="Enter your password" 
              required
              autocomplete="current-password"
            >
            <div style="text-align: right; margin-top: var(--spacing-sm);">
              <a href="#forgotPasswordModal" style="font-size: 0.875rem; color: var(--primary); text-decoration: none;">
                Forgot password?
              </a>
            </div>
          </div>

          <button type="submit" class="login-btn" id="loginBtn">
            <span id="loginLoading" class="hidden">
              <div class="spinner"></div>
              Signing in...
            </span>
            <span id="loginText">
              <i class="fas fa-sign-in-alt"></i>
              Sign In
            </span>
          </button>
        </form>

        <!-- TOTP step — shown after successful password auth when 2FA is required -->
        <div id="totpStep" style="display:none;">
          <div style="text-align:center; margin-bottom: var(--spacing-lg);">
            <i class="fas fa-shield-alt" style="font-size:2rem; color: var(--primary);"></i>
            <h3 style="margin: var(--spacing-sm) 0 var(--spacing-xs);">Two-Factor Authentication</h3>
            <p style="color: var(--text-secondary); font-size: 0.875rem; margin:0;">
              Enter the 6-digit code from your authenticator app.
            </p>
          </div>
          <div class="form-group">
            <label class="form-label" for="totpToken">Authenticator Code</label>
            <input
              type="text"
              id="totpToken"
              class="form-control"
              placeholder="000000"
              maxlength="6"
              inputmode="numeric"
              autocomplete="one-time-code"
              style="text-align:center; font-size:1.5rem; letter-spacing:0.5rem;"
            >
          </div>
          <button type="button" class="login-btn" id="totpSubmitBtn">
            <span id="totpLoading" class="hidden">
              <div class="spinner"></div>
              Verifying...
            </span>
            <span id="totpText">
              <i class="fas fa-check"></i>
              Verify
            </span>
          </button>
          <div style="text-align:center; margin-top: var(--spacing-md);">
            <a href="/login" style="font-size: 0.875rem; color: var(--gray-500);">
              <i class="fas fa-arrow-left"></i> Back to login
            </a>
          </div>
        </div>

        <% if (typeof oidcEnabled !== 'undefined' && oidcEnabled) { %>
        <div class="login-options">
          <span>or continue with</span>
        </div>

        <div class="login-links">
          <a href="/api/auth/oidc/login" class="login-link">
            <i class="fas fa-key"></i>
            <span>Login with SSO</span>
          </a>
        </div>
        <% } %>
      </div>
    </div>

    <div style="text-align:center; margin-top: var(--spacing-lg); font-size: 0.875rem; color: var(--text-secondary);">
      Don't have an account? <a href="/request-invite" style="color: var(--primary); text-decoration: none; font-weight: 500;">Request an Invite</a>
    </div>
  </div>

  <!-- Forgot Password Modal -->
  <div id="forgotPasswordModal" style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); display: none; align-items: center; justify-content: center; z-index: 2000;">
    <div style="background: white; border-radius: var(--border-radius-lg); padding: var(--spacing-2xl); max-width: 400px; width: 90%; box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);">
      <h2 style="margin-top: 0; color: var(--text-primary);">Forgot Password?</h2>
      <p style="color: var(--text-secondary); margin-bottom: var(--spacing-lg);">Enter your username to receive a password reset link via email.</p>
      
      <div id="forgotPasswordAlert" style="display: none; padding: var(--spacing-md); border-radius: var(--border-radius); margin-bottom: var(--spacing-lg);"></div>
      
      <form id="forgotPasswordForm">
        <div class="form-group">
          <label class="form-label" for="forgotUsername">Username</label>
          <input 
            type="text" 
            id="forgotUsername" 
            name="username" 
            class="form-control" 
            placeholder="Enter your username" 
            required
            autocomplete="username">
        </div>
        
        <div style="display: flex; gap: var(--spacing-md);">
          <button type="submit" class="login-btn" style="flex: 1;">
            Send Reset Link
          </button>
          <button type="button" id="closeForgotPasswordBtn" class="login-btn" style="background: var(--bg-light); color: var(--text-primary); flex: 1;">
            Cancel
          </button>
        </div>
      </form>
    </div>
  </div>

  <script src="/js/login.js"></script>
  <% if (typeof requireTotp !== 'undefined' && requireTotp) { %>
  <script nonce="<%= nonce %>">
    document.addEventListener('DOMContentLoaded', function() {
      if (typeof showTotpStep === 'function') showTotpStep();
    });
  </script>
  <% } %>
</body>
</html>