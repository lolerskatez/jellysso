<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= csrfToken || '' %>">
  <title>Webhooks - JellySSO Admin</title>
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/layout.css">
  <link rel="stylesheet" href="/css/fontawesome.css">
  <style>
    .stats-row { display:flex; gap:var(--spacing-lg); margin-bottom:var(--spacing-xl); flex-wrap:wrap; }
    .stat-card { flex:1; min-width:130px; padding:var(--spacing-lg); background:var(--bg-primary); border:1px solid var(--border-color); border-radius:var(--border-radius); }
    .stat-card .val { font-size:2rem; font-weight:700; }
    .stat-card .lbl { color:var(--text-muted); font-size:.85rem; }
    .filter-row { display:flex; gap:10px; margin-bottom:var(--spacing-xl); align-items:center; flex-wrap:wrap; }
    .filter-row select, .filter-row input { padding:8px 12px; border:1px solid var(--border-color); border-radius:var(--border-radius); background:var(--bg-secondary); color:var(--text-primary); font-size:.9rem; }
    .btn-primary { background:linear-gradient(135deg,var(--primary),#0066cc); color:white; padding:10px 20px; border:none; border-radius:var(--border-radius); cursor:pointer; font-weight:600; }
    .btn-secondary { background:var(--bg-secondary); color:var(--text-primary); padding:8px 16px; border:1px solid var(--border-color); border-radius:var(--border-radius); cursor:pointer; }
    .btn-danger { background:#dc3545; color:white; padding:7px 14px; border:none; border-radius:var(--border-radius); cursor:pointer; }
    .btn-sm { padding:4px 10px; font-size:.82rem; }
    .badge { display:inline-block; padding:2px 9px; border-radius:20px; font-size:.76rem; font-weight:700; }
    .badge-active { background:#d4edda; color:#155724; }
    .badge-inactive { background:#f8d7da; color:#721c24; }
    .badge-event { background:#cce5ff; color:#004085; margin:1px 2px; }
    table { width:100%; border-collapse:collapse; }
    th { text-align:left; padding:10px 12px; background:var(--bg-secondary); color:var(--text-muted); font-size:.82rem; text-transform:uppercase; letter-spacing:.5px; border-bottom:2px solid var(--border-color); }
    td { padding:10px 12px; border-bottom:1px solid var(--border-color); font-size:.9rem; vertical-align:top; }
    tr:hover td { background:var(--bg-secondary); }
    .url-cell { font-family:monospace; font-size:.82rem; word-break:break-all; max-width:220px; }
    .actions-cell { display:flex; gap:6px; flex-wrap:wrap; }
    .empty-state { text-align:center; padding:var(--spacing-2xl); color:var(--text-muted); }
    .empty-state i { font-size:3rem; margin-bottom:var(--spacing-md); display:block; }
    /* Modal */
    .modal-overlay { display:none; position:fixed; z-index:500; top:0; left:0; width:100% !important; height:100% !important; max-width:none !important; background:rgba(0,0,0,.55) !important; }
    .modal-overlay.open { display:flex; align-items:center; justify-content:center; opacity:1; visibility:visible; }
    .modal { background:var(--bg-primary); border:1px solid var(--border-color); border-radius:var(--border-radius); box-shadow:var(--shadow-lg); padding:var(--spacing-lg); width:100%; max-width:560px; max-height:90vh; overflow-y:auto; }
    .modal-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:var(--spacing-lg); padding-bottom:var(--spacing-lg); border-bottom:2px solid var(--border-color); }
    .modal-header h2 { margin:0; color:var(--text-primary); font-size:1.25rem; font-weight:700; letter-spacing:-0.3px; }
    .modal-close { background:none; border:none; font-size:1.5rem; cursor:pointer; color:var(--text-secondary); width:32px; height:32px; display:flex; align-items:center; justify-content:center; transition:all var(--transition); border-radius:var(--border-radius-sm); }
    .modal-close:hover { color:var(--text-primary); background:var(--bg-secondary); }
    .modal-actions { display:flex; gap:var(--spacing-md); justify-content:flex-end; margin-top:var(--spacing-xl); padding-top:var(--spacing-lg); border-top:1px solid var(--border-color); }
    .form-group { margin-bottom:var(--spacing-lg); }
    .form-group label { display:block; margin-bottom:6px; font-size:.88rem; font-weight:600; }
    .form-group input, .form-group select, .form-group textarea { width:100%; padding:9px 12px; border:1px solid var(--border-color); border-radius:var(--border-radius); background:var(--bg-secondary); color:var(--text-primary); font-size:.9rem; box-sizing:border-box; }
    .form-group textarea { resize:vertical; min-height:70px; }
    .events-grid { display:flex; flex-wrap:wrap; gap:6px; padding:10px; border:1px solid var(--border-color); border-radius:var(--border-radius); background:var(--bg-secondary); }
    .events-grid label { display:flex; align-items:center; gap:5px; font-size:.82rem; font-weight:400; cursor:pointer; }
    .modal-footer { display:flex; gap:10px; justify-content:flex-end; margin-top:var(--spacing-xl); }
    /* Events drawer */
    .drawer-overlay { display:none; position:fixed; inset:0; background:rgba(0,0,0,.4); z-index:1000; }
    .drawer-overlay.open { display:block; }
    .drawer { position:fixed; right:0; top:0; bottom:0; width:520px; max-width:95vw; background:var(--bg-primary); border-left:1px solid var(--border-color); z-index:1001; overflow-y:auto; padding:var(--spacing-2xl); box-sizing:border-box; transform:translateX(100%); transition:transform .25s; }
    .drawer.open { transform:translateX(0); }
    .drawer-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:var(--spacing-xl); }
    .status-delivered { color:#28a745; }
    .status-failed { color:#dc3545; }
    .status-pending { color:#ffc107; }
    #toastMsg { position:fixed; bottom:20px; right:20px; padding:12px 20px; border-radius:var(--border-radius); color:white; font-weight:600; z-index:2000; opacity:0; transition:opacity .3s; }
    #toastMsg.show { opacity:1; }
    #toastMsg.success { background:#28a745; }
    #toastMsg.error { background:#dc3545; }
  </style>
</head>
<body>
  <div class="app-container">
    <%- include('../partials/navigation', { user, currentPage: 'admin-webhooks' }) %>
    <main class="main-content">
      <header class="header">
        <div class="header-left">
          <button class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Toggle menu">
            <i class="fas fa-bars"></i>
          </button>
          <h1 class="header-title">
            <i class="fas fa-plug" style="margin-right:8px;color:var(--primary)"></i>Webhooks
          </h1>
        </div>
        <div class="header-right">
          <button class="btn-primary" id="newWebhookBtn"><i class="fas fa-plus"></i> New Webhook</button>
        </div>
      </header>

      <div class="page-content">
        <p style="color:var(--text-muted);margin:0 0 var(--spacing-lg) 0">Manage outbound webhooks for event-driven integrations.</p>

        <div class="stats-row" id="statsRow">
          <div class="stat-card"><div class="val" id="statTotal">—</div><div class="lbl">Total</div></div>
          <div class="stat-card"><div class="val" style="color:#28a745" id="statActive">—</div><div class="lbl">Active</div></div>
          <div class="stat-card"><div class="val" style="color:#dc3545" id="statFailed">—</div><div class="lbl">Failed Deliveries</div></div>
        </div>

        <div class="filter-row">
          <input type="text" id="filterSearch" placeholder="Filter by URL or user ID…" style="flex:1;min-width:180px">
          <select id="filterStatus">
            <option value="">All Status</option>
            <option value="1">Active Only</option>
            <option value="0">Inactive Only</option>
          </select>
          <button class="btn-secondary" id="refreshWebhooksBtn"><i class="fas fa-sync"></i> Refresh</button>
        </div>

        <div id="tableWrap">
          <table>
            <thead>
              <tr>
                <th>ID</th>
                <th>URL</th>
                <th>User ID</th>
                <th>Events</th>
                <th>Status</th>
                <th>Deliveries</th>
                <th>Created</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="webhookTbody">
              <tr><td colspan="8" class="empty-state"><i class="fas fa-spinner fa-spin"></i> Loading…</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>

<!-- Create/Edit Modal -->
<div class="modal-overlay" id="webhookModal">
  <div class="modal">
    <div class="modal-header">
      <h2 id="modalTitle"><i class="fas fa-plug" style="margin-right:8px;color:var(--primary)"></i>New Webhook</h2>
      <button class="modal-close" id="closeWebhookModalBtn">&times;</button>
    </div>
    <input type="hidden" id="editId">

    <div class="form-group">
      <label>User ID</label>
      <input type="text" id="wUserId" placeholder="Jellyfin user ID (required)">
    </div>
    <div class="form-group">
      <label>Endpoint URL</label>
      <input type="url" id="wUrl" placeholder="https://example.com/hook">
    </div>
    <div class="form-group">
      <label>Events to subscribe</label>
      <div class="events-grid" id="eventsGrid">
        <label><input type="checkbox" value="user.login"> user.login</label>
        <label><input type="checkbox" value="user.logout"> user.logout</label>
        <label><input type="checkbox" value="user.created"> user.created</label>
        <label><input type="checkbox" value="user.deleted"> user.deleted</label>
        <label><input type="checkbox" value="user.updated"> user.updated</label>
        <label><input type="checkbox" value="policy.changed"> policy.changed</label>
        <label><input type="checkbox" value="invite.used"> invite.used</label>
        <label><input type="checkbox" value="account.locked"> account.locked</label>
        <label><input type="checkbox" value="account.unlocked"> account.unlocked</label>
        <label><input type="checkbox" value="test.ping"> test.ping</label>
      </div>
    </div>
    <div class="form-group">
      <label>Secret (HMAC signing key, optional)</label>
      <input type="text" id="wSecret" placeholder="Leave blank for no signature">
    </div>
    <div class="form-group" style="display:flex;gap:16px">
      <div style="flex:1">
        <label>Retry Count (0–10)</label>
        <input type="number" id="wRetry" min="0" max="10" value="3">
      </div>
      <div style="flex:1">
        <label>Timeout (5–120s)</label>
        <input type="number" id="wTimeout" min="5" max="120" value="30">
      </div>
    </div>
    <div id="modalError" style="color:#dc3545;margin-bottom:12px;display:none;"></div>
    <div class="modal-actions">
      <button class="btn-secondary" id="cancelWebhookBtn">Cancel</button>
      <button class="btn-primary" id="modalSaveBtn"><i class="fas fa-save"></i> Save</button>
    </div>
  </div>
</div>

<!-- Events Drawer -->
<div class="drawer-overlay" id="drawerOverlay"></div>
<div class="drawer" id="eventsDrawer">
  <div class="drawer-header">
    <h3 id="drawerTitle">Delivery History</h3>
    <button class="btn-secondary btn-sm" id="closeDrawerBtn"><i class="fas fa-times"></i></button>
  </div>
  <div id="drawerContent"><p style="color:var(--text-muted)">Loading…</p></div>
</div>

<div id="toastMsg"></div>

<script src="/js/mobile-nav.js"></script>
<script src="/js/admin-webhooks.js"></script>
</body>
</html>
