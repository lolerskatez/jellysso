<!-- Base Navigation Component -->
<!-- Pass user and currentPage variables when including this partial -->
<!-- theme-init.js reads localStorage and sets data-theme on <html> before paint -->
<script src="/js/theme-init.js"></script>
<style>
  /* Collapsible section group button (acts as header + toggle) */
  .nav-group-btn {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 9px var(--spacing-lg);
    background: none;
    border: none;
    border-left: 3px solid transparent;
    color: var(--text-muted);
    font-size: 0.7rem;
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.8px;
    cursor: pointer;
    text-align: left;
    transition: color 0.15s, background 0.15s;
  }
  .nav-group-btn:hover {
    color: var(--text-secondary);
    background: var(--bg-secondary);
  }
  .nav-group-btn.active {
    color: var(--text-secondary);
    border-left-color: var(--border-color);
  }
  .nav-group-btn i.group-icon {
    width: 20px;
    text-align: center;
    font-size: 1rem;
  }
  .nav-group-btn .toggle-icon {
    margin-left: auto;
    font-size: 0.6rem;
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }
  .nav-group-btn[aria-expanded="true"] .toggle-icon {
    transform: rotate(90deg);
  }
  /* Subnav panel */
  .nav-subnav {
    display: none;
    border-left: 2px solid var(--border-color);
    margin-left: 28px;
    margin-top: 1px;
    margin-bottom: 4px;
  }
  .nav-subnav.open {
    display: block;
  }
  .nav-subnav .nav-link {
    font-size: 0.875rem;
    padding-top: 7px;
    padding-bottom: 7px;
  }
  .nav-subnav .nav-link i {
    font-size: 0.875rem;
  }
  /* Thin divider between sidebar sections */
  .nav-section-divider {
    border: none;
    border-top: 1px solid var(--border-color);
    margin: var(--spacing-sm) var(--spacing-lg);
  }
  /* Plain section label (non-interactive) */
  .nav-section-label {
    padding: var(--spacing-sm) var(--spacing-lg) 2px;
    font-size: 0.68rem;
    text-transform: uppercase;
    color: var(--text-muted);
    font-weight: 700;
    letter-spacing: 0.8px;
  }
</style>
<div class="sidebar-overlay" id="sidebarOverlay"></div>
<aside class="sidebar" id="sidebar">
  <div class="sidebar-header">
    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 8px;">
      <img src="/logo-icon.svg" alt="<%= locals.appName || 'JellySSO' %>" style="width: 40px; height: 40px;">
      <h2 style="margin: 0; font-size: 1.5rem; font-weight: 700;"><%= locals.appName || 'JellySSO' %></h2>
    </div>
    <p><%= user?.Policy?.IsAdministrator ? 'Admin Dashboard' : 'User Dashboard' %></p>
  </div>

  <nav class="sidebar-nav">

    <!-- ── Admin Overview ───────────────────────────────── -->
    <% if (user?.Policy?.IsAdministrator) { %>
      <div class="nav-item">
        <a href="/admin/" class="nav-link <%= currentPage === 'admin-dashboard' ? 'active' : '' %>">
          <i class="fas fa-chart-bar"></i>
          Overview
        </a>
      </div>
      <hr class="nav-section-divider">
    <% } %>

    <!-- ── My Space (all users) ─────────────────────────── -->
    <% if (user?.Policy?.IsAdministrator) { %>
      <div class="nav-section-label">My Space</div>
    <% } %>
    <div class="nav-item">
      <a href="/quickconnect" class="nav-link <%= currentPage === 'quickconnect' ? 'active' : '' %>">
        <i class="fas fa-mobile-alt"></i>
        QuickConnect
      </a>
    </div>
    <div class="nav-item">
      <a href="/playback" class="nav-link <%= currentPage === 'playback' ? 'active' : '' %>">
        <i class="fas fa-play-circle"></i>
        Playback
      </a>
    </div>
    <div class="nav-item">
      <a href="/account" class="nav-link <%= currentPage === 'account' ? 'active' : '' %>">
        <i class="fas fa-user-circle"></i>
        My Account
      </a>
    </div>
    <div class="nav-item">
      <a href="/admin/client-guide" class="nav-link <%= currentPage === 'client-guide' ? 'active' : '' %>">
        <i class="fas fa-life-ring"></i>
        Client Setup Guide
      </a>
    </div>

    <!-- ── Admin Sections ───────────────────────────────── -->
    <% if (user?.Policy?.IsAdministrator) { %>
      <hr class="nav-section-divider">

      <!-- Users group -->
      <div class="nav-item">
        <button class="nav-group-btn <%= ['admin-users','admin-invites','admin-profiles','admin-expiry'].includes(currentPage) ? 'active' : '' %>"
                data-toggle="usersSubnav"
                aria-expanded="false"
                aria-label="Toggle Users section">
          <i class="fas fa-users group-icon"></i>
          Users
          <i class="fas fa-chevron-right toggle-icon"></i>
        </button>
        <div class="nav-subnav" id="usersSubnav">
          <div class="nav-item">
            <a href="/admin/users" class="nav-link <%= currentPage === 'admin-users' ? 'active' : '' %>">
              <i class="fas fa-list-ul"></i>
              User Management
            </a>
          </div>
          <div class="nav-item">
            <a href="/admin/invites" class="nav-link <%= currentPage === 'admin-invites' ? 'active' : '' %>">
              <i class="fas fa-envelope"></i>
              Invites
            </a>
          </div>
          <div class="nav-item">
            <a href="/admin/signup-profiles" class="nav-link <%= currentPage === 'admin-profiles' ? 'active' : '' %>">
              <i class="fas fa-user-tie"></i>
              Signup Profiles
            </a>
          </div>
          <div class="nav-item">
            <a href="/admin/user-expiry" class="nav-link <%= currentPage === 'admin-expiry' ? 'active' : '' %>">
              <i class="fas fa-hourglass-end"></i>
              User Expiry
            </a>
          </div>
        </div>
      </div>

      <!-- Communications group -->
      <div class="nav-item">
        <button class="nav-group-btn <%= ['admin-notifications','admin-message-templates'].includes(currentPage) ? 'active' : '' %>"
                data-toggle="commsSubnav"
                aria-expanded="false"
                aria-label="Toggle Communications section">
          <i class="fas fa-bell group-icon"></i>
          Communications
          <i class="fas fa-chevron-right toggle-icon"></i>
        </button>
        <div class="nav-subnav" id="commsSubnav">
          <div class="nav-item">
            <a href="/admin/notifications" class="nav-link <%= currentPage === 'admin-notifications' ? 'active' : '' %>">
              <i class="fas fa-bell"></i>
              Notifications
            </a>
          </div>
          <div class="nav-item">
            <a href="/admin/message-templates" class="nav-link <%= currentPage === 'admin-message-templates' ? 'active' : '' %>">
              <i class="fas fa-envelope-open-text"></i>
              Message Templates
            </a>
          </div>
        </div>
      </div>

      <!-- Security group -->
      <div class="nav-item">
        <button class="nav-group-btn <%= ['admin-policy','admin-oidc'].includes(currentPage) ? 'active' : '' %>"
                data-toggle="securitySubnav"
                aria-expanded="false"
                aria-label="Toggle Security section">
          <i class="fas fa-shield-alt group-icon"></i>
          Security
          <i class="fas fa-chevron-right toggle-icon"></i>
        </button>
        <div class="nav-subnav" id="securitySubnav">
          <div class="nav-item">
            <a href="/admin/policy" class="nav-link <%= currentPage === 'admin-policy' ? 'active' : '' %>">
              <i class="fas fa-shield-alt"></i>
              Policy Management
            </a>
          </div>
          <div class="nav-item">
            <a href="/admin/oidc" class="nav-link <%= currentPage === 'admin-oidc' ? 'active' : '' %>">
              <i class="fas fa-key"></i>
              OIDC SSO
            </a>
          </div>
        </div>
      </div>

      <!-- System group -->
      <div class="nav-item">
        <button class="nav-group-btn <%= ['admin-settings','admin-audit-logs','admin-backups','admin-plugins','admin-troubleshoot','admin-playback-sessions'].includes(currentPage) ? 'active' : '' %>"
                data-toggle="systemSubnav"
                aria-expanded="false"
                aria-label="Toggle System section">
          <i class="fas fa-server group-icon"></i>
          System
          <i class="fas fa-chevron-right toggle-icon"></i>
        </button>
        <div class="nav-subnav" id="systemSubnav">
          <div class="nav-item">
            <a href="/admin/playback-sessions" class="nav-link <%= currentPage === 'admin-playback-sessions' ? 'active' : '' %>">
              <i class="fas fa-play-circle"></i>
              Playback Sessions
            </a>
          </div>
          <div class="nav-item">
            <a href="/admin/settings" class="nav-link <%= currentPage === 'admin-settings' ? 'active' : '' %>">
              <i class="fas fa-cog"></i>
              Settings
            </a>
          </div>
          <div class="nav-item">
            <a href="/admin/audit-logs" class="nav-link <%= currentPage === 'admin-audit-logs' ? 'active' : '' %>">
              <i class="fas fa-file-alt"></i>
              Audit Logs
            </a>
          </div>
          <div class="nav-item">
            <a href="/admin/backups" class="nav-link <%= currentPage === 'admin-backups' ? 'active' : '' %>">
              <i class="fas fa-database"></i>
              Backups
            </a>
          </div>
          <div class="nav-item">
            <a href="/admin/plugins" class="nav-link <%= currentPage === 'admin-plugins' ? 'active' : '' %>">
              <i class="fas fa-puzzle-piece"></i>
              Plugin Management
            </a>
          </div>
          <div class="nav-item">
            <a href="/admin/troubleshoot" class="nav-link <%= currentPage === 'admin-troubleshoot' ? 'active' : '' %>">
              <i class="fas fa-tools"></i>
              Troubleshooting
            </a>
          </div>
        </div>
      </div>
    <% } %>

  </nav>

  <!-- Bottom Navigation (Logout) -->
  <div style="margin-top: auto; padding-top: var(--spacing-lg); border-top: 1px solid var(--border-color);">
    <button id="logoutBtn" class="nav-link" style="justify-content: center; width: 100%; border: none; background: none; cursor: pointer; margin-bottom: var(--spacing-lg);">
      <i class="fas fa-sign-out-alt"></i>
      <span>Logout</span>
    </button>
  </div>
</aside>
<script nonce="<%= nonce %>">
  (function () {
    var groupMap = {
      usersSubnav:    ['admin-users', 'admin-invites', 'admin-profiles', 'admin-expiry'],
      commsSubnav:    ['admin-notifications', 'admin-message-templates'],
      securitySubnav: ['admin-policy', 'admin-oidc'],
      systemSubnav:   ['admin-settings', 'admin-audit-logs', 'admin-backups', 'admin-plugins', 'admin-troubleshoot', 'admin-playback-sessions']
    };
    var currentPage = '<%= currentPage %>';

    document.querySelectorAll('.nav-group-btn').forEach(function (btn) {
      var subnavId = btn.getAttribute('data-toggle');
      var subnav = document.getElementById(subnavId);
      if (!subnav) return;

      function openGroup() {
        subnav.classList.add('open');
        btn.setAttribute('aria-expanded', 'true');
      }
      function closeGroup() {
        subnav.classList.remove('open');
        btn.setAttribute('aria-expanded', 'false');
      }

      // Auto-open if the current page belongs to this group
      if (groupMap[subnavId] && groupMap[subnavId].includes(currentPage)) {
        openGroup();
      }

      btn.addEventListener('click', function () {
        subnav.classList.contains('open') ? closeGroup() : openGroup();
      });
    });
  })();
</script>
