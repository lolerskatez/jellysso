<!-- Base Navigation Component -->
<!-- Pass user and currentPage variables when including this partial -->
<!-- theme-init.js reads localStorage and sets data-theme on <html> before paint -->
<script src="/js/theme-init.js"></script>
<style>
  .nav-group-header {
    display: flex;
    align-items: center;
  }
  .nav-group-link {
    flex: 1;
    min-width: 0;
  }
  .nav-group-toggle {
    flex-shrink: 0;
    background: none;
    border: none;
    cursor: pointer;
    color: rgba(255, 255, 255, 0.45);
    padding: 4px 12px 4px 4px;
    line-height: 1;
    transition: color 0.15s;
  }
  .nav-group-toggle:hover {
    color: rgba(255, 255, 255, 0.9);
  }
  .nav-group-toggle i {
    transition: transform 0.2s ease;
    font-size: 0.7rem;
  }
  .nav-group-toggle[aria-expanded="true"] i {
    transform: rotate(90deg);
  }
  .nav-subnav {
    display: none;
    border-left: 2px solid rgba(255, 255, 255, 0.12);
    margin-left: 22px;
    margin-top: 2px;
    margin-bottom: 4px;
  }
  .nav-subnav.open {
    display: block;
  }
  .nav-subnav .nav-link {
    font-size: 0.875rem;
    padding-top: 7px;
    padding-bottom: 7px;
  }
</style>
<div class="sidebar-overlay" id="sidebarOverlay"></div>
<aside class="sidebar" id="sidebar">
  <div class="sidebar-header">
    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 8px;">
      <img src="/logo-icon.svg" alt="<%= locals.appName || 'JellySSO' %>" style="width: 40px; height: 40px;">
      <h2 style="margin: 0; font-size: 1.5rem; font-weight: 700;"><%= locals.appName || 'JellySSO' %></h2>
    </div>
    <p><%= user?.Policy?.IsAdministrator ? 'Admin Dashboard' : 'User Dashboard' %></p>
  </div>

  <nav class="sidebar-nav">
    <!-- Admin Dashboard (at the top for admins only) -->
    <% if (user?.Policy?.IsAdministrator) { %>
      <div class="nav-item">
        <a href="/admin/" class="nav-link <%= currentPage === 'admin-dashboard' ? 'active' : '' %>">
          <i class="fas fa-chart-bar"></i>
          Admin Dashboard
        </a>
      </div>
    <% } %>
    
    <!-- QuickConnect (for all users) -->
    <div class="nav-item">
      <a href="/quickconnect" class="nav-link <%= currentPage === 'quickconnect' ? 'active' : '' %>">
        <i class="fas fa-mobile-alt"></i>
        QuickConnect
      </a>
    </div>

    <!-- Playback Control (for all users) -->
    <div class="nav-item">
      <a href="/playback" class="nav-link <%= currentPage === 'playback' ? 'active' : '' %>">
        <i class="fas fa-play-circle"></i>
        Playback Control
      </a>
    </div>

    <!-- Jellyfin Client Guide (for all users) -->
    <div class="nav-item">
      <a href="/admin/client-guide" class="nav-link <%= currentPage === 'client-guide' ? 'active' : '' %>">
        <i class="fas fa-life-ring"></i>
        Client Setup Guide
      </a>
    </div>

    <!-- My Membership (for all non-admin users; admins may also access it) -->
    <div class="nav-item">
      <a href="/membership" class="nav-link <%= currentPage === 'membership' ? 'active' : '' %>">
        <i class="fas fa-id-card"></i>
        My Membership
      </a>
    </div>

    <!-- My Account (for all users) -->
    <div class="nav-item">
      <a href="/account" class="nav-link <%= currentPage === 'account' ? 'active' : '' %>">
        <i class="fas fa-user"></i>
        My Account
      </a>
    </div>

    <!-- Admin Tools Section (only for admins) -->
    <% if (user?.Policy?.IsAdministrator) { %>
      <div style="margin: var(--spacing-lg) 0; border-top: 1px solid rgba(255, 255, 255, 0.1); padding-top: var(--spacing-md);">
        <div style="padding: 0 var(--spacing-lg); font-size: 0.75rem; text-transform: uppercase; color: rgba(255, 255, 255, 0.5); font-weight: 600; letter-spacing: 0.5px;">Admin Tools</div>
      </div>

      <div class="nav-item">
        <a href="/admin/users" class="nav-link <%= currentPage === 'admin-users' ? 'active' : '' %>">
          <i class="fas fa-users"></i>
          User Management
        </a>
      </div>
      <div class="nav-item">
        <div class="nav-group-header">
          <a href="/admin/settings" class="nav-link nav-group-link <%= ['admin-settings','admin-audit-logs','admin-backups','admin-oidc'].includes(currentPage) ? 'active' : '' %>">
            <i class="fas fa-cog"></i>
            Settings
          </a>
          <button class="nav-group-toggle" id="settingsToggle" aria-label="Toggle settings submenu" aria-expanded="false">
            <i class="fas fa-chevron-right"></i>
          </button>
        </div>
        <div class="nav-subnav" id="settingsSubnav">
          <div class="nav-item">
            <a href="/admin/audit-logs" class="nav-link <%= currentPage === 'admin-audit-logs' ? 'active' : '' %>">
              <i class="fas fa-file-alt"></i>
              Audit Logs
            </a>
          </div>
          <div class="nav-item">
            <a href="/admin/backups" class="nav-link <%= currentPage === 'admin-backups' ? 'active' : '' %>">
              <i class="fas fa-database"></i>
              Backups
            </a>
          </div>
          <div class="nav-item">
            <a href="/admin/oidc" class="nav-link <%= currentPage === 'admin-oidc' ? 'active' : '' %>">
              <i class="fas fa-key"></i>
              OIDC SSO
            </a>
          </div>
        </div>
      </div>
      <div class="nav-item">
        <a href="/admin/plugins" class="nav-link <%= currentPage === 'admin-plugins' ? 'active' : '' %>">
          <i class="fas fa-puzzle-piece"></i>
          Plugin Management
        </a>
      </div>
      <div class="nav-item">
        <a href="/admin/troubleshoot" class="nav-link <%= currentPage === 'admin-troubleshoot' ? 'active' : '' %>">
          <i class="fas fa-tools"></i>
          App Troubleshooting
        </a>
      </div>
      <div class="nav-item">
        <a href="/admin/playback-sessions" class="nav-link <%= currentPage === 'admin-playback-sessions' ? 'active' : '' %>">
          <i class="fas fa-play-circle"></i>
          Playback Administration
        </a>
      </div>
      <div class="nav-item">
        <a href="/admin/policy" class="nav-link <%= currentPage === 'admin-policy' ? 'active' : '' %>">
          <i class="fas fa-shield-alt"></i>
          Policy Management
        </a>
      </div>

      <!-- Phase 2: User Lifecycle Management -->
      <div style="margin: var(--spacing-lg) 0; border-top: 1px solid rgba(255, 255, 255, 0.1); padding-top: var(--spacing-md);">
        <div style="padding: 0 var(--spacing-lg); font-size: 0.75rem; text-transform: uppercase; color: rgba(255, 255, 255, 0.5); font-weight: 600; letter-spacing: 0.5px;">User Lifecycle</div>
      </div>

      <div class="nav-item">
        <a href="/admin/invites" class="nav-link <%= currentPage === 'admin-invites' ? 'active' : '' %>">
          <i class="fas fa-envelope"></i>
          Invite Management
        </a>
      </div>
      <div class="nav-item">
        <a href="/admin/signup-profiles" class="nav-link <%= currentPage === 'admin-profiles' ? 'active' : '' %>">
          <i class="fas fa-user-tie"></i>
          Signup Profiles
        </a>
      </div>
      <div class="nav-item">
        <a href="/admin/user-expiry" class="nav-link <%= currentPage === 'admin-expiry' ? 'active' : '' %>">
          <i class="fas fa-hourglass-end"></i>
          User Expiry
        </a>
      </div>
      <div class="nav-item">
        <a href="/admin/notifications" class="nav-link <%= currentPage === 'admin-notifications' ? 'active' : '' %>">
          <i class="fas fa-bell"></i>
          Notifications
        </a>
      </div>
    <% } %>
  </nav>

  <!-- Bottom Navigation (Logout) -->
  <div style="margin-top: auto; padding-top: var(--spacing-lg); border-top: 1px solid rgba(255, 255, 255, 0.1);">
    <button id="logoutBtn" class="nav-link" style="justify-content: center; width: 100%; border: none; background: none; cursor: pointer; color: rgba(255, 255, 255, 0.8); margin-bottom: var(--spacing-lg);">
      <i class="fas fa-sign-out-alt"></i>
      <span>Logout</span>
    </button>
  </div>
</aside>
<script>
  (function () {
    var settingsPages = ['admin-settings', 'admin-audit-logs', 'admin-backups', 'admin-oidc'];
    var currentPage = '<%= currentPage %>';
    var toggle = document.getElementById('settingsToggle');
    var subnav = document.getElementById('settingsSubnav');

    if (!toggle || !subnav) return;

    function open() {
      subnav.classList.add('open');
      toggle.setAttribute('aria-expanded', 'true');
    }

    function close() {
      subnav.classList.remove('open');
      toggle.setAttribute('aria-expanded', 'false');
    }

    if (settingsPages.includes(currentPage)) open();

    toggle.addEventListener('click', function () {
      subnav.classList.contains('open') ? close() : open();
    });
  })();
</script>
