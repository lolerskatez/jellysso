<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= csrfToken || '' %>">
  <title>Announcements - JellySSO Admin</title>
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/layout.css">
  <link rel="stylesheet" href="/css/fontawesome.css">
  <style>
    .page-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: var(--spacing-2xl);
    }
    .btn-primary {
      background: linear-gradient(135deg, var(--primary), #0066cc);
      color: white;
      padding: 10px 20px;
      border: none;
      border-radius: var(--border-radius);
      cursor: pointer;
      font-weight: 600;
      transition: opacity 0.2s;
    }
    .btn-primary:hover { opacity: 0.9; }
    .btn-primary:disabled { opacity: 0.6; cursor: not-allowed; }
    .btn-danger {
      background: #dc3545;
      color: white;
      padding: 6px 14px;
      border: none;
      border-radius: var(--border-radius);
      cursor: pointer;
      font-size: 0.85rem;
      transition: opacity 0.2s;
    }
    .btn-danger:hover { opacity: 0.85; }
    .btn-secondary {
      background: var(--bg-secondary);
      color: var(--text-primary);
      padding: 6px 14px;
      border: 1px solid var(--border-color);
      border-radius: var(--border-radius);
      cursor: pointer;
      font-size: 0.85rem;
      transition: background 0.2s;
    }
    .btn-secondary:hover { background: var(--bg-tertiary); }
    .announcement-card {
      background: var(--bg-primary);
      border: 1px solid var(--border-color);
      border-radius: var(--border-radius);
      padding: var(--spacing-lg);
      margin-bottom: var(--spacing-md);
    }
    .announcement-card.inactive { opacity: 0.6; border-style: dashed; }
    .announcement-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: var(--spacing-md);
    }
    .announcement-title { font-weight: 700; font-size: 1.05rem; margin: 0 0 4px 0; }
    .announcement-meta { font-size: 0.8rem; color: var(--text-muted); }
    .announcement-body { margin-top: var(--spacing-sm); color: var(--text-secondary); }
    .announcement-actions { display: flex; gap: 8px; flex-shrink: 0; }
    .badge {
      display: inline-block;
      padding: 2px 8px;
      border-radius: 12px;
      font-size: 0.75rem;
      font-weight: 600;
    }
    .badge-active { background: #28a74522; color: #28a745; border: 1px solid #28a74566; }
    .badge-inactive { background: #6c757d22; color: #6c757d; border: 1px solid #6c757d66; }
    .badge-expired { background: #dc354522; color: #dc3545; border: 1px solid #dc354566; }
    .priority-indicator {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: 0.8rem;
      color: var(--text-muted);
    }
    .empty-state {
      text-align: center;
      padding: var(--spacing-2xl);
      color: var(--text-muted);
    }
    .empty-state i { font-size: 3rem; margin-bottom: var(--spacing-md); display: block; }
    .modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.5);
      z-index: 1000;
      align-items: center;
      justify-content: center;
    }
    .modal.show { display: flex; }
    .modal-content {
      background: var(--bg-primary);
      border-radius: var(--border-radius);
      padding: var(--spacing-2xl);
      width: 90%;
      max-width: 560px;
      box-shadow: 0 8px 32px rgba(0,0,0,0.3);
    }
    .modal-content h3 { margin: 0 0 var(--spacing-lg) 0; }
    .form-group { margin-bottom: var(--spacing-lg); }
    .form-group label { display: block; margin-bottom: 6px; font-weight: 600; font-size: 0.9rem; }
    .form-group input, .form-group textarea, .form-group select {
      width: 100%;
      padding: 8px 12px;
      border: 1px solid var(--border-color);
      border-radius: var(--border-radius);
      background: var(--bg-secondary);
      color: var(--text-primary);
      font-size: 0.95rem;
      box-sizing: border-box;
    }
    .form-group textarea { min-height: 100px; resize: vertical; }
    .modal-footer { display: flex; gap: 10px; justify-content: flex-end; margin-top: var(--spacing-lg); }
    #toastMsg {
      position: fixed;
      bottom: 20px;
      right: 20px;
      padding: 12px 20px;
      border-radius: var(--border-radius);
      color: white;
      font-weight: 600;
      z-index: 2000;
      opacity: 0;
      transition: opacity 0.3s;
    }
    #toastMsg.show { opacity: 1; }
    #toastMsg.success { background: #28a745; }
    #toastMsg.error { background: #dc3545; }
  </style>
</head>
<body>
<%- include('../partials/navigation', { user, currentPage: 'admin-announcements' }) %>
<div class="main-content">
  <div class="content-wrapper">
    <div class="page-header">
      <div>
        <h1><i class="fas fa-bullhorn"></i> Announcements</h1>
        <p style="color:var(--text-muted);margin:4px 0 0 0">Broadcast messages shown to all users on the login and dashboard pages.</p>
      </div>
      <button class="btn-primary" onclick="openCreate()"><i class="fas fa-plus"></i> New Announcement</button>
    </div>

    <div id="announcementsList">
      <div class="empty-state"><i class="fas fa-spinner fa-spin"></i><p>Loading announcements…</p></div>
    </div>
  </div>
</div>

<!-- Create/Edit Modal -->
<div class="modal" id="announcementModal">
  <div class="modal-content">
    <h3 id="modalTitle">New Announcement</h3>
    <input type="hidden" id="editId">
    <div class="form-group">
      <label for="annTitle">Title <span style="color:#dc3545">*</span></label>
      <input type="text" id="annTitle" placeholder="Announcement title" maxlength="200">
    </div>
    <div class="form-group">
      <label for="annMessage">Message <span style="color:#dc3545">*</span></label>
      <textarea id="annMessage" placeholder="Announcement body…"></textarea>
    </div>
    <div class="form-group" style="display:flex;gap:var(--spacing-lg)">
      <div style="flex:1">
        <label for="annPriority">Display Priority</label>
        <input type="number" id="annPriority" value="0" min="0" max="100" style="width:100%">
        <small style="color:var(--text-muted)">Higher = shown first</small>
      </div>
      <div style="flex:1">
        <label for="annExpires">Expires At (optional)</label>
        <input type="datetime-local" id="annExpires">
      </div>
    </div>
    <div class="form-group" id="activeToggleGroup" style="display:none">
      <label>
        <input type="checkbox" id="annActive" checked>
        Active (visible to users)
      </label>
    </div>
    <div class="modal-footer">
      <button class="btn-secondary" onclick="closeModal()">Cancel</button>
      <button class="btn-primary" onclick="saveAnnouncement()">Save</button>
    </div>
  </div>
</div>

<div id="toastMsg"></div>

<script src="/js/mobile-nav.js"></script>
<script src="/js/admin-announcements.js"></script>
</body>
</html>
