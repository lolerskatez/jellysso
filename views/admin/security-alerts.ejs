<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= csrfToken || '' %>">
  <title>Security Alerts - JellySSO Admin</title>
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/layout.css">
  <link rel="stylesheet" href="/css/fontawesome.css">
  <style>
    .stats-row { display:flex; gap:var(--spacing-lg); margin-bottom:var(--spacing-xl); flex-wrap:wrap; }
    .stat-card { flex:1; min-width:140px; padding:var(--spacing-lg); background:var(--bg-primary); border:1px solid var(--border-color); border-radius:var(--border-radius); }
    .stat-card .val { font-size:2rem; font-weight:700; }
    .stat-card .lbl { color:var(--text-muted); font-size:.85rem; }
    .sev-critical { color:#dc3545; }
    .sev-high     { color:#fd7e14; }
    .sev-medium   { color:#ffc107; }
    .sev-low      { color:#17a2b8; }
    .sev-badge { display:inline-block; padding:3px 10px; border-radius:20px; font-size:.78rem; font-weight:700; text-transform:uppercase; letter-spacing:.5px; }
    .sev-badge.critical { background:#f8d7da; color:#721c24; }
    .sev-badge.high     { background:#ffe5d0; color:#7d3c00; }
    .sev-badge.medium   { background:#fff3cd; color:#856404; }
    .sev-badge.low      { background:#d1ecf1; color:#0c5460; }
    .filter-row { display:flex; gap:10px; margin-bottom:var(--spacing-xl); align-items:center; flex-wrap:wrap; }
    .filter-row select, .filter-row input { padding:8px 12px; border:1px solid var(--border-color); border-radius:var(--border-radius); background:var(--bg-secondary); color:var(--text-primary); font-size:.9rem; }
    .btn-primary { background:linear-gradient(135deg,var(--primary),#0066cc); color:white; padding:10px 20px; border:none; border-radius:var(--border-radius); cursor:pointer; font-weight:600; }
    .btn-danger { background:#dc3545; color:white; padding:7px 14px; border:none; border-radius:var(--border-radius); cursor:pointer; }
    .btn-danger:hover { opacity:.85; }
    .btn-secondary { background:var(--bg-secondary); color:var(--text-primary); padding:8px 16px; border:1px solid var(--border-color); border-radius:var(--border-radius); cursor:pointer; }
    .btn-sm { padding:3px 8px; font-size:.8rem; }
    .alert-list { display:flex; flex-direction:column; gap:var(--spacing-sm); }
    .alert-item { display:flex; gap:var(--spacing-lg); align-items:flex-start; padding:var(--spacing-lg); background:var(--bg-primary); border:1px solid var(--border-color); border-radius:var(--border-radius); border-left:4px solid var(--border-color); transition:opacity .2s; }
    .alert-item.read { opacity:.55; }
    .alert-item.critical { border-left-color:#dc3545; }
    .alert-item.high     { border-left-color:#fd7e14; }
    .alert-item.medium   { border-left-color:#ffc107; }
    .alert-item.low      { border-left-color:#17a2b8; }
    .alert-icon { font-size:1.4rem; margin-top:2px; min-width:28px; text-align:center; }
    .alert-body { flex:1; }
    .alert-title { font-weight:700; margin:0 0 4px 0; }
    .alert-meta { color:var(--text-muted); font-size:.82rem; display:flex; gap:10px; flex-wrap:wrap; }
    .alert-actions { display:flex; gap:6px; align-items:flex-start; }
    .empty-state { text-align:center; padding:var(--spacing-2xl); color:var(--text-muted); }
    .empty-state i { font-size:3rem; margin-bottom:var(--spacing-md); display:block; }
    #toastMsg { position:fixed; bottom:20px; right:20px; padding:12px 20px; border-radius:var(--border-radius); color:white; font-weight:600; z-index:2000; opacity:0; transition:opacity .3s; }
    #toastMsg.show { opacity:1; }
    #toastMsg.success { background:#28a745; }
    #toastMsg.error { background:#dc3545; }
    .toolbar { display:flex; gap:10px; justify-content:flex-end; margin-bottom:var(--spacing-lg); }
  </style>
</head>
<body>
  <div class="app-container">
    <%- include('../partials/navigation', { user, currentPage: 'admin-security-alerts' }) %>
    <main class="main-content">
      <header class="header">
        <div class="header-left">
          <button class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Toggle menu">
            <i class="fas fa-bars"></i>
          </button>
          <h1 class="header-title">
            <i class="fas fa-shield-alt" style="margin-right:8px;color:var(--primary)"></i>Security Alerts
          </h1>
        </div>
      </header>

      <div class="page-content">
        <p style="color:var(--text-muted);margin:0 0 var(--spacing-lg) 0">System-wide security events and suspicious activity log.</p>

        <div class="stats-row" id="statsRow">
          <div class="stat-card"><div class="val sev-critical" id="stat-critical">—</div><div class="lbl">Critical</div></div>
          <div class="stat-card"><div class="val sev-high" id="stat-high">—</div><div class="lbl">High</div></div>
          <div class="stat-card"><div class="val sev-medium" id="stat-medium">—</div><div class="lbl">Medium</div></div>
          <div class="stat-card"><div class="val sev-low" id="stat-low">—</div><div class="lbl">Low</div></div>
          <div class="stat-card"><div class="val" id="stat-unread">—</div><div class="lbl">Unread</div></div>
        </div>

        <div class="filter-row">
          <select id="filterSeverity">
            <option value="">All Severities</option>
            <option value="critical">Critical</option>
            <option value="high">High</option>
            <option value="medium">Medium</option>
            <option value="low">Low</option>
          </select>
          <select id="filterType">
            <option value="">All Types</option>
            <option value="failed_login">Failed Login</option>
            <option value="new_device">New Device</option>
            <option value="policy_change">Policy Change</option>
            <option value="password_change">Password Change</option>
            <option value="account_locked">Account Locked</option>
            <option value="suspicious_activity">Suspicious Activity</option>
            <option value="permission_change">Permission Change</option>
            <option value="api_key_created">API Key Created</option>
            <option value="api_key_revoked">API Key Revoked</option>
          </select>
          <select id="filterRead">
            <option value="">All</option>
            <option value="1">Unread Only</option>
          </select>
          <button class="btn-secondary" id="refreshAlertsBtn"><i class="fas fa-sync"></i> Refresh</button>
        </div>

        <div class="toolbar">
          <button class="btn-secondary" id="markAllReadBtn"><i class="fas fa-check-double"></i> Mark All Read</button>
          <button class="btn-danger" id="clearAlertsBtn"><i class="fas fa-trash"></i> Clear All</button>
        </div>

        <div id="alertsList">
          <div style="padding:40px;text-align:center;color:var(--text-muted)"><i class="fas fa-spinner fa-spin" style="font-size:2rem"></i></div>
        </div>
      </div>
    </main>
  </div>

<div id="toastMsg"></div>

<script src="/js/mobile-nav.js"></script>
<script src="/js/admin-security-alerts.js"></script>
</body>
</html>
