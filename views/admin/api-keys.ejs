<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= csrfToken || '' %>">
  <title>API Keys - JellySSO Admin</title>
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/layout.css">
  <link rel="stylesheet" href="/css/fontawesome.css">
  <style>
    .btn-primary { background:linear-gradient(135deg,var(--primary),#0066cc); color:white; padding:10px 20px; border:none; border-radius:var(--border-radius); cursor:pointer; font-weight:600; transition:opacity .2s; }
    .btn-primary:hover { opacity:.9; }
    .btn-danger { background:#dc3545; color:white; padding:5px 12px; border:none; border-radius:var(--border-radius); cursor:pointer; font-size:.85rem; }
    .btn-danger:hover { opacity:.85; }
    .btn-secondary { background:var(--bg-secondary); color:var(--text-primary); padding:5px 12px; border:1px solid var(--border-color); border-radius:var(--border-radius); cursor:pointer; font-size:.85rem; }
    .btn-secondary:hover { background:var(--bg-tertiary); }
    .perm-badge { display:inline-block; padding:2px 8px; border-radius:10px; font-size:.75rem; font-weight:600; margin-right:4px; }
    .perm-read    { background:#17a2b822; color:#17a2b8; border:1px solid #17a2b866; }
    .perm-write   { background:#ffc10722; color:#856404; border:1px solid #ffc10766; }
    .perm-admin   { background:#dc354522; color:#dc3545; border:1px solid #dc354566; }
    .status-active   { color:#28a745; font-weight:600; }
    .status-revoked  { color:#6c757d; }
    .status-expired  { color:#dc3545; }
    table { width:100%; border-collapse:collapse; }
    th, td { padding:10px 12px; text-align:left; border-bottom:1px solid var(--border-color); font-size:.9rem; }
    th { background:var(--bg-secondary); color:var(--text-muted); font-size:.8rem; text-transform:uppercase; letter-spacing:.5px; }
    tr:hover td { background:var(--bg-secondary); }
    .mono { font-family:monospace; font-size:.85rem; }
    .empty-state { text-align:center; padding:var(--spacing-2xl); color:var(--text-muted); }
    .empty-state i { font-size:3rem; margin-bottom:var(--spacing-md); display:block; }
    .modal { display:none; position:fixed; z-index:500; top:0; left:0; width:100% !important; height:100% !important; max-width:none !important; max-height:none !important; border-radius:0 !important; box-shadow:none !important; overflow:visible !important; animation:none !important; background:rgba(0,0,0,.5) !important; }
    .modal.show { display:flex; align-items:center; justify-content:center; }
    .modal-content { background:var(--bg-primary); border-radius:var(--border-radius); box-shadow:var(--shadow-lg); max-width:500px; width:92%; max-height:90vh; overflow-y:auto; padding:var(--spacing-lg); border:1px solid var(--border-color); }
    .modal-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:var(--spacing-lg); padding-bottom:var(--spacing-lg); border-bottom:2px solid var(--border-color); }
    .modal-header h2 { margin:0; color:var(--text-primary); font-size:1.25rem; font-weight:700; letter-spacing:-0.3px; }
    .modal-close { background:none; border:none; font-size:1.5rem; cursor:pointer; color:var(--text-secondary); width:32px; height:32px; display:flex; align-items:center; justify-content:center; transition:all var(--transition); border-radius:var(--border-radius-sm); }
    .modal-close:hover { color:var(--text-primary); background:var(--bg-secondary); }
    .modal-actions { display:flex; gap:var(--spacing-md); justify-content:flex-end; margin-top:var(--spacing-xl); padding-top:var(--spacing-lg); border-top:1px solid var(--border-color); }
    .form-group { margin-bottom:var(--spacing-lg); }
    .form-group label { display:block; margin-bottom:6px; font-weight:600; font-size:.9rem; }
    .form-group input, .form-group select { width:100%; padding:8px 12px; border:1px solid var(--border-color); border-radius:var(--border-radius); background:var(--bg-secondary); color:var(--text-primary); font-size:.95rem; box-sizing:border-box; }
    .perm-checkboxes { display:flex; gap:var(--spacing-lg); }
    .perm-checkboxes label { font-weight:400 !important; display:flex; align-items:center; gap:6px; cursor:pointer; }
    .new-key-box { background:#d4edda; border:1px solid #c3e6cb; border-radius:var(--border-radius); padding:var(--spacing-lg); margin-bottom:var(--spacing-lg); word-break:break-all; font-family:monospace; font-size:.9rem; }
    #toastMsg { position:fixed; bottom:20px; right:20px; padding:12px 20px; border-radius:var(--border-radius); color:white; font-weight:600; z-index:2000; opacity:0; transition:opacity .3s; }
    #toastMsg.show { opacity:1; }
    #toastMsg.success { background:#28a745; }
    #toastMsg.error { background:#dc3545; }
  </style>
</head>
<body>
  <div class="app-container">
    <%- include('../partials/navigation', { user, currentPage: 'admin-api-keys' }) %>
    <main class="main-content">
      <header class="header">
        <div class="header-left">
          <button class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Toggle menu">
            <i class="fas fa-bars"></i>
          </button>
          <h1 class="header-title">
            <i class="fas fa-key" style="margin-right:8px;color:var(--primary)"></i>API Keys
          </h1>
        </div>
        <div class="header-right">
          <button class="btn-primary" id="createKeyBtn"><i class="fas fa-plus"></i> Create Key</button>
        </div>
      </header>

      <div class="page-content">
        <p style="color:var(--text-muted);margin:0 0 var(--spacing-lg) 0">Programmatic access keys for the JellySSO REST API.</p>
        <div class="card" style="background:var(--bg-primary);border:1px solid var(--border-color);border-radius:var(--border-radius);overflow:hidden">
          <div id="keysTable">
            <div style="padding:40px;text-align:center;color:var(--text-muted)"><i class="fas fa-spinner fa-spin" style="font-size:2rem"></i></div>
          </div>
        </div>
      </div>
    </main>
  </div>

<!-- Create modal -->
<div class="modal" id="createModal">
  <div class="modal-content">
    <div class="modal-header">
      <h2><i class="fas fa-key" style="margin-right:8px;color:var(--primary)"></i>Create API Key</h2>
      <button class="modal-close" id="closeCreateModalBtn">&times;</button>
    </div>
    <div id="newKeyDisplay" style="display:none">
      <p style="color:#155724;font-weight:600;margin-bottom:8px"><i class="fas fa-check-circle"></i> Key created — copy it now, it won't be shown again.</p>
      <div class="new-key-box" id="newKeyValue"></div>
      <button class="btn-secondary" id="copyKeyBtn" style="margin-bottom:var(--spacing-lg)"><i class="fas fa-copy"></i> Copy</button>
    </div>
    <div id="createForm">
      <div class="form-group">
        <label for="keyUserId">User ID <span style="color:var(--danger)">*</span></label>
        <input type="text" id="keyUserId" placeholder="Jellyfin user ID">
        <small style="color:var(--text-muted)">Find user IDs on the Users page.</small>
      </div>
      <div class="form-group">
        <label for="keyName">Name <span style="color:var(--danger)">*</span></label>
        <input type="text" id="keyName" placeholder="e.g. Home Assistant integration" maxlength="100">
      </div>
      <div class="form-group">
        <label>Permissions</label>
        <div class="perm-checkboxes">
          <label><input type="checkbox" id="permRead" checked> Read</label>
          <label><input type="checkbox" id="permWrite"> Write</label>
          <label><input type="checkbox" id="permAdmin"> Admin</label>
        </div>
      </div>
      <div class="form-group">
        <label for="keyExpires">Expires At (optional)</label>
        <input type="datetime-local" id="keyExpires">
      </div>
    </div>
    <div class="modal-actions">
      <button class="btn-secondary" id="cancelCreateBtn">Close</button>
      <button class="btn-primary" id="saveKeyBtn"><i class="fas fa-plus"></i> Create</button>
    </div>
  </div>
</div>

<div id="toastMsg"></div>

<script src="/js/mobile-nav.js"></script>
<script src="/js/admin-api-keys.js"></script>
</body>
</html>
