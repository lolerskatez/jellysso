<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= csrfToken || '' %>">
  <title>Device Whitelist - JellySSO Admin</title>
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/layout.css">
  <link rel="stylesheet" href="/css/fontawesome.css">
  <style>
    .page-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:var(--spacing-2xl); }
    .filter-row { display:flex; gap:10px; margin-bottom:var(--spacing-xl); align-items:center; flex-wrap:wrap; }
    .filter-row input, .filter-row select { padding:8px 12px; border:1px solid var(--border-color); border-radius:var(--border-radius); background:var(--bg-secondary); color:var(--text-primary); font-size:.9rem; }
    .btn-primary { background:linear-gradient(135deg,var(--primary),#0066cc); color:white; padding:9px 18px; border:none; border-radius:var(--border-radius); cursor:pointer; font-weight:600; }
    .btn-secondary { background:var(--bg-secondary); color:var(--text-primary); padding:8px 14px; border:1px solid var(--border-color); border-radius:var(--border-radius); cursor:pointer; }
    .btn-danger { background:#dc3545; color:white; padding:6px 12px; border:none; border-radius:var(--border-radius); cursor:pointer; }
    .btn-sm { padding:4px 10px; font-size:.82rem; }
    table { width:100%; border-collapse:collapse; }
    th { text-align:left; padding:10px 12px; background:var(--bg-secondary); color:var(--text-muted); font-size:.82rem; text-transform:uppercase; letter-spacing:.5px; border-bottom:2px solid var(--border-color); }
    td { padding:9px 12px; border-bottom:1px solid var(--border-color); font-size:.88rem; }
    tr:hover td { background:var(--bg-secondary); }
    .uid-cell { font-family:monospace; font-size:.8rem; max-width:200px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .empty-state { text-align:center; padding:var(--spacing-2xl); color:var(--text-muted); }
    .empty-state i { font-size:3rem; margin-bottom:var(--spacing-md); display:block; }
    /* Modal */
    .modal-overlay { display:none; position:fixed; inset:0; background:rgba(0,0,0,.55); z-index:1000; align-items:center; justify-content:center; }
    .modal-overlay.open { display:flex; }
    .modal { background:var(--bg-primary); border:1px solid var(--border-color); border-radius:var(--border-radius); padding:var(--spacing-2xl); width:100%; max-width:480px; }
    .modal h2 { margin:0 0 var(--spacing-xl); }
    .form-group { margin-bottom:var(--spacing-lg); }
    .form-group label { display:block; margin-bottom:6px; font-size:.88rem; font-weight:600; }
    .form-group input { width:100%; padding:9px 12px; border:1px solid var(--border-color); border-radius:var(--border-radius); background:var(--bg-secondary); color:var(--text-primary); font-size:.9rem; box-sizing:border-box; }
    .modal-footer { display:flex; gap:10px; justify-content:flex-end; margin-top:var(--spacing-xl); }
    #toastMsg { position:fixed; bottom:20px; right:20px; padding:12px 20px; border-radius:var(--border-radius); color:white; font-weight:600; z-index:2000; opacity:0; transition:opacity .3s; }
    #toastMsg.show { opacity:1; }
    #toastMsg.success { background:#28a745; }
    #toastMsg.error { background:#dc3545; }
  </style>
</head>
<body>
<%- include('../partials/navigation', { user, currentPage: 'admin-device-whitelist' }) %>
<div class="main-content">
  <div class="content-wrapper">
    <div class="page-header">
      <div>
        <h1><i class="fas fa-laptop"></i> Device Whitelist</h1>
        <p style="color:var(--text-muted);margin:4px 0 0 0">Manage trusted devices for policy-restricted users.</p>
      </div>
      <button class="btn-primary" onclick="openAddModal()"><i class="fas fa-plus"></i> Add Device</button>
    </div>

    <div class="filter-row">
      <input type="text" id="filterUserId" placeholder="Filter by User ID…" oninput="debounceLoad()" style="flex:1;min-width:180px">
      <button class="btn-secondary" onclick="loadDevices()"><i class="fas fa-sync"></i> Refresh</button>
    </div>

    <div id="tableWrap" style="overflow-x:auto">
      <table>
        <thead>
          <tr>
            <th>User ID</th>
            <th>Device ID</th>
            <th>Device Name</th>
            <th>Type</th>
            <th>Added</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="deviceTbody">
          <tr><td colspan="6"><div class="empty-state"><i class="fas fa-spinner fa-spin"></i> Loading…</div></td></tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Add Device Modal -->
<div class="modal-overlay" id="addModal">
  <div class="modal">
    <h2>Add Device to Whitelist</h2>
    <div class="form-group">
      <label>User ID</label>
      <input type="text" id="mUserId" placeholder="Jellyfin user ID">
    </div>
    <div class="form-group">
      <label>Device ID</label>
      <input type="text" id="mDeviceId" placeholder="e.g. abc123def456">
    </div>
    <div class="form-group">
      <label>Device Name (optional)</label>
      <input type="text" id="mDeviceName" placeholder="e.g. Living Room TV">
    </div>
    <div class="form-group">
      <label>Device Type (optional)</label>
      <input type="text" id="mDeviceType" placeholder="e.g. SmartTV, Mobile">
    </div>
    <div id="addModalError" style="color:#dc3545;margin-bottom:10px;display:none;font-size:.875rem;"></div>
    <div class="modal-footer">
      <button class="btn-secondary" onclick="closeModal()">Cancel</button>
      <button class="btn-primary" id="addSaveBtn" onclick="saveDevice()">Add Device</button>
    </div>
  </div>
</div>

<div id="toastMsg"></div>

<script src="/js/admin-device-whitelist.js"></script>
</body>
</html>
