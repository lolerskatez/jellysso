<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= csrfToken || '' %>">
  <title>Notification Management - JellySSO Admin</title>
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/layout.css">
  <link rel="stylesheet" href="/css/fontawesome.css">
  <style>
    .page-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: var(--spacing-2xl);
      flex-wrap: wrap;
      gap: var(--spacing-md);
    }

    /* ── Stat cards ── */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: var(--spacing-lg);
      margin-bottom: var(--spacing-2xl);
    }

    .stat-card {
      background: var(--bg-primary);
      border: 1px solid var(--border-color);
      border-radius: var(--border-radius);
      padding: var(--spacing-lg);
      text-align: center;
    }

    .stat-card.stat-pending  { border-top: 3px solid #f59e0b; }
    .stat-card.stat-sent     { border-top: 3px solid #10b981; }
    .stat-card.stat-failed   { border-top: 3px solid #ef4444; }
    .stat-card.stat-skipped  { border-top: 3px solid #6b7280; }

    .stat-value {
      font-size: 2rem;
      font-weight: 700;
      color: var(--primary);
      margin: 0;
    }

    .stat-label {
      font-size: 0.9rem;
      color: var(--text-secondary);
      margin: 5px 0 0 0;
    }

    /* ── Channel status cards ── */
    .channels-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: var(--spacing-lg);
      margin-bottom: var(--spacing-2xl);
    }

    .channel-card {
      display: flex;
      align-items: center;
      gap: var(--spacing-md);
      background: var(--bg-primary);
      border: 1px solid var(--border-color);
      border-radius: var(--border-radius);
      padding: var(--spacing-lg);
    }

    .channel-icon {
      font-size: 1.8rem;
      width: 48px;
      text-align: center;
    }

    .channel-info { flex: 1; }

    .channel-name {
      font-weight: 600;
      margin: 0 0 4px;
      font-size: 1rem;
    }

    .channel-status {
      font-size: 0.8rem;
      margin: 0;
    }

    .status-dot {
      display: inline-block;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      margin-right: 4px;
    }

    .status-dot.connected    { background: #10b981; }
    .status-dot.disconnected { background: #ef4444; }
    .status-dot.disabled     { background: #9ca3af; }

    /* ── Tabs ── */
    .tabs {
      display: flex;
      gap: var(--spacing-md);
      margin-bottom: var(--spacing-xl);
      border-bottom: 2px solid var(--border-color);
      flex-wrap: wrap;
    }

    .tab {
      padding: var(--spacing-md) var(--spacing-lg);
      cursor: pointer;
      border: none;
      background: none;
      font-size: 1rem;
      font-weight: 600;
      color: var(--text-secondary);
      border-bottom: 3px solid transparent;
      transition: all 0.2s;
      margin-bottom: -2px;
    }

    .tab.active {
      color: var(--primary);
      border-bottom-color: var(--primary);
    }

    .tab-content { display: none; }
    .tab-content.active { display: block; }

    /* ── Table ── */
    .data-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.9rem;
    }

    .data-table th {
      text-align: left;
      padding: var(--spacing-md);
      background: var(--bg-secondary);
      border-bottom: 2px solid var(--border-color);
      font-weight: 600;
      white-space: nowrap;
    }

    .data-table td {
      padding: var(--spacing-md);
      border-bottom: 1px solid var(--border-color);
      vertical-align: middle;
    }

    .data-table tr:last-child td { border-bottom: none; }

    .table-wrapper { overflow-x: auto; }

    /* ── Badges ── */
    .badge {
      display: inline-block;
      padding: 2px 8px;
      border-radius: 12px;
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
    }

    .badge-pending  { background: #fef3c7; color: #92400e; }
    .badge-sent     { background: #d1fae5; color: #065f46; }
    .badge-failed   { background: #fee2e2; color: #991b1b; }
    .badge-skipped  { background: #f3f4f6; color: #374151; }

    /* ── Actions bar ── */
    .actions-bar {
      display: flex;
      gap: var(--spacing-md);
      margin-bottom: var(--spacing-xl);
      flex-wrap: wrap;
      align-items: center;
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--primary), #0066cc);
      color: white;
      padding: 10px 20px;
      border: none;
      border-radius: var(--border-radius);
      cursor: pointer;
      font-weight: 600;
      transition: opacity 0.2s;
    }

    .btn-primary:hover { opacity: 0.9; }
    .btn-primary:disabled { opacity: 0.6; cursor: not-allowed; }

    .btn-danger {
      background: #ef4444;
      color: white;
      padding: 8px 16px;
      border: none;
      border-radius: var(--border-radius);
      cursor: pointer;
      font-weight: 600;
      font-size: 0.875rem;
      transition: opacity 0.2s;
    }

    .btn-danger:hover { opacity: 0.85; }

    .btn-secondary {
      background: var(--bg-secondary);
      color: var(--text-primary);
      padding: 8px 16px;
      border: 1px solid var(--border-color);
      border-radius: var(--border-radius);
      cursor: pointer;
      font-weight: 600;
      font-size: 0.875rem;
      transition: background 0.2s;
    }

    .btn-secondary:hover { background: var(--border-color); }

    .btn-small {
      padding: 4px 10px;
      font-size: 0.8rem;
      border-radius: 4px;
      cursor: pointer;
      border: none;
    }

    .btn-cancel { background: #ef4444; color: white; }
    .btn-cancel:hover { opacity: 0.85; }

    /* ── Filters ── */
    .filter-bar {
      display: flex;
      gap: var(--spacing-md);
      margin-bottom: var(--spacing-lg);
      flex-wrap: wrap;
    }

    .filter-bar select {
      padding: 8px 12px;
      border: 1px solid var(--border-color);
      border-radius: var(--border-radius);
      background: var(--bg-primary);
      color: var(--text-primary);
      font-size: 0.9rem;
    }

    /* ── Manual send form ── */
    .send-form {
      background: var(--bg-primary);
      border: 1px solid var(--border-color);
      border-radius: var(--border-radius);
      padding: var(--spacing-xl);
      max-width: 600px;
    }

    .form-group { margin-bottom: var(--spacing-lg); }

    .form-group label {
      display: block;
      font-weight: 600;
      margin-bottom: 6px;
      font-size: 0.9rem;
    }

    .form-group input,
    .form-group select,
    .form-group textarea {
      width: 100%;
      padding: 10px 12px;
      border: 1px solid var(--border-color);
      border-radius: var(--border-radius);
      background: var(--bg-secondary);
      color: var(--text-primary);
      font-size: 0.9rem;
      box-sizing: border-box;
    }

    .form-group textarea { resize: vertical; min-height: 80px; }

    .channel-checkboxes {
      display: flex;
      gap: var(--spacing-lg);
      flex-wrap: wrap;
    }

    .channel-checkboxes label {
      display: flex;
      align-items: center;
      gap: 6px;
      font-weight: normal;
      cursor: pointer;
    }

    /* ── Alert ── */
    .alert {
      padding: var(--spacing-md) var(--spacing-lg);
      border-radius: var(--border-radius);
      margin-bottom: var(--spacing-lg);
      font-weight: 500;
    }

    .alert-success { background: #d1fae5; color: #065f46; border: 1px solid #6ee7b7; }
    .alert-error   { background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; }
    .alert-info    { background: #dbeafe; color: #1e40af; border: 1px solid #93c5fd; }

    /* ── Empty state ── */
    .empty-state {
      text-align: center;
      padding: var(--spacing-2xl);
      color: var(--text-secondary);
    }

    /* ── Pagination ── */
    .pagination {
      display: flex;
      gap: var(--spacing-sm);
      justify-content: flex-end;
      margin-top: var(--spacing-lg);
      align-items: center;
    }

    .page-btn {
      padding: 6px 12px;
      border: 1px solid var(--border-color);
      border-radius: var(--border-radius);
      cursor: pointer;
      background: var(--bg-primary);
      color: var(--text-primary);
      font-size: 0.85rem;
    }

    .page-btn.active { background: var(--primary); color: white; border-color: var(--primary); }
    .page-btn:disabled { opacity: 0.5; cursor: not-allowed; }

    .truncate-text {
      max-width: 200px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  </style>
</head>
<body>
  <div class="app-container">
    <%- include('../partials/navigation', { user, currentPage: 'admin-notifications' }) %>
    <main class="main-content">
      <header class="header">
        <div class="header-left">
          <button class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Toggle menu">
            <i class="fas fa-bars"></i>
          </button>
          <h1 class="header-title">Notification Management</h1>
        </div>
        <div class="header-right">
          <button class="btn-secondary" id="btnRefreshAll">
            <i class="fas fa-sync-alt"></i> Refresh
          </button>
        </div>
      </header>

      <div class="page-content">
        <div id="alertContainer"></div>

        <!-- Queue stat cards -->
        <div class="stats-grid">
          <div class="stat-card stat-pending">
            <p class="stat-value" id="statPending">-</p>
            <p class="stat-label">Pending</p>
          </div>
          <div class="stat-card stat-sent">
            <p class="stat-value" id="statSent">-</p>
            <p class="stat-label">Sent</p>
          </div>
          <div class="stat-card stat-failed">
            <p class="stat-value" id="statFailed">-</p>
            <p class="stat-label">Failed</p>
          </div>
          <div class="stat-card stat-skipped">
            <p class="stat-value" id="statSkipped">-</p>
            <p class="stat-label">Skipped</p>
          </div>
        </div>

        <!-- Channel status -->
        <h2 style="margin-bottom: var(--spacing-lg); font-size: 1.1rem;">Channel Status</h2>
        <div class="channels-grid" id="channelsGrid">
          <div class="channel-card">
            <div class="channel-icon" style="color:#6b7280;"><i class="fas fa-spinner fa-spin"></i></div>
            <div class="channel-info"><p class="channel-name">Loading...</p></div>
          </div>
        </div>

        <!-- Main tabs -->
        <div class="tabs">
          <button class="tab active" id="tabQueue" data-tab="queue">
            <i class="fas fa-list"></i> Queue
          </button>
          <button class="tab" id="tabLogs" data-tab="logs">
            <i class="fas fa-history"></i> Delivery Logs
          </button>
          <button class="tab" id="tabSend" data-tab="send">
            <i class="fas fa-paper-plane"></i> Send Manual
          </button>
        </div>

        <!-- ── Queue Tab ── -->
        <div id="queueTab" class="tab-content active">
          <div class="actions-bar">
            <div class="filter-bar">
              <select id="queueStatusFilter">
                <option value="">All Statuses</option>
                <option value="pending">Pending</option>
                <option value="sent">Sent</option>
                <option value="failed">Failed</option>
                <option value="skipped">Skipped</option>
              </select>
            </div>
            <div style="margin-left: auto; display: flex; gap: var(--spacing-md);">
              <button class="btn-danger" id="btnClearQueue">
                <i class="fas fa-trash"></i> Clear Completed
              </button>
            </div>
          </div>

          <div class="table-wrapper">
            <table class="data-table">
              <thead>
                <tr>
                  <th>User</th>
                  <th>Template</th>
                  <th>Channels</th>
                  <th>Priority</th>
                  <th>Status</th>
                  <th>Retries</th>
                  <th>Created</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody id="queueTableBody">
                <tr>
                  <td colspan="8" class="empty-state">Loading queue...</td>
                </tr>
              </tbody>
            </table>
          </div>
          <div class="pagination" id="queuePagination"></div>
        </div>

        <!-- ── Logs Tab ── -->
        <div id="logsTab" class="tab-content">
          <div class="actions-bar">
            <div class="filter-bar">
              <select id="logsChannelFilter">
                <option value="">All Channels</option>
                <option value="email">Email</option>
                <option value="discord">Discord</option>
                <option value="telegram">Telegram</option>
                <option value="matrix">Matrix</option>
              </select>
              <select id="logsStatusFilter">
                <option value="">All Statuses</option>
                <option value="sent">Sent</option>
                <option value="failed">Failed</option>
              </select>
            </div>
            <div style="margin-left: auto;">
              <button class="btn-danger" id="btnClearLogs">
                <i class="fas fa-trash"></i> Clear All Logs
              </button>
            </div>
          </div>

          <div class="table-wrapper">
            <table class="data-table">
              <thead>
                <tr>
                  <th>User</th>
                  <th>Template</th>
                  <th>Channel</th>
                  <th>Status</th>
                  <th>Error</th>
                  <th>Delivered</th>
                  <th>Created</th>
                </tr>
              </thead>
              <tbody id="logsTableBody">
                <tr>
                  <td colspan="7" class="empty-state">Select the Delivery Logs tab to load.</td>
                </tr>
              </tbody>
            </table>
          </div>
          <div class="pagination" id="logsPagination"></div>
        </div>

        <!-- ── Send Manual Tab ── -->
        <div id="sendTab" class="tab-content">
          <div class="send-form">
            <h3 style="margin: 0 0 var(--spacing-lg);">Send Manual Notification</h3>

            <div class="form-group">
              <label for="sendUserId">User ID (Jellyfin user ID)</label>
              <input type="text" id="sendUserId" placeholder="e.g. a1b2c3d4-000...">
            </div>

            <div class="form-group">
              <label for="sendTemplate">Template</label>
              <select id="sendTemplate">
                <option value="">Loading templates...</option>
              </select>
            </div>

            <div class="form-group">
              <label>Channels</label>
              <div class="channel-checkboxes">
                <label><input type="checkbox" name="sendChannel" value="email" checked> Email</label>
                <label><input type="checkbox" name="sendChannel" value="discord"> Discord</label>
                <label><input type="checkbox" name="sendChannel" value="telegram"> Telegram</label>
                <label><input type="checkbox" name="sendChannel" value="matrix"> Matrix</label>
              </div>
            </div>

            <div class="form-group">
              <label for="sendVariables">Variables (JSON, optional)</label>
              <textarea id="sendVariables" placeholder='{"username": "john", "expiryDate": "2025-01-01"}'></textarea>
            </div>

            <button class="btn-primary" id="btnSendManual">
              <i class="fas fa-paper-plane"></i> Send Notification
            </button>
          </div>
        </div>

      </div><!-- /.page-content -->
    </main>
  </div><!-- /.app-container -->

  <script src="/js/admin-notifications.js"></script>

  <script src="/js/mobile-nav.js"></script>
</body>
</html>
