<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= csrfToken || '' %>">
  <title>Message Templates - JellySSO Admin</title>
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/layout.css">
  <link rel="stylesheet" href="/css/fontawesome.css">
  <style>
    .templates-layout {
      display: grid;
      grid-template-columns: 280px 1fr;
      gap: var(--spacing-xl);
      align-items: start;
    }

    @media (max-width: 768px) {
      .templates-layout { grid-template-columns: 1fr; }
    }

    .template-list {
      background: var(--bg-primary);
      border: 1px solid var(--border-color);
      border-radius: var(--border-radius);
      overflow: hidden;
    }

    .template-list-header {
      padding: var(--spacing-md) var(--spacing-lg);
      background: var(--bg-light);
      border-bottom: 1px solid var(--border-color);
      font-weight: 600;
      font-size: 0.9rem;
      color: var(--text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .template-item {
      padding: var(--spacing-md) var(--spacing-lg);
      cursor: pointer;
      border-bottom: 1px solid var(--border-color);
      transition: background 0.15s;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--spacing-sm);
    }

    .template-item:last-child { border-bottom: none; }
    .template-item:hover { background: var(--bg-light); }
    .template-item.active { background: rgba(0, 102, 204, 0.08); border-left: 3px solid var(--primary); }

    .template-item-name {
      font-weight: 500;
      font-size: 0.9rem;
    }

    .template-item-key {
      font-size: 0.75rem;
      color: var(--text-secondary);
      font-family: monospace;
    }

    .badge-active { color: #059669; font-size: 0.7rem; }
    .badge-inactive { color: #9ca3af; font-size: 0.7rem; }

    .editor-panel {
      background: var(--bg-primary);
      border: 1px solid var(--border-color);
      border-radius: var(--border-radius);
      padding: var(--spacing-xl);
    }

    .editor-panel.empty-state {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 400px;
      color: var(--text-secondary);
    }

    .editor-panel.empty-state i {
      font-size: 3rem;
      margin-bottom: var(--spacing-lg);
      opacity: 0.3;
    }

    .editor-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      margin-bottom: var(--spacing-xl);
      gap: var(--spacing-lg);
    }

    .editor-title h2 { margin: 0 0 4px 0; font-size: 1.2rem; }
    .editor-title small { color: var(--text-secondary); font-family: monospace; font-size: 0.8rem; }

    .editor-actions { display: flex; gap: var(--spacing-sm); flex-shrink: 0; }

    .form-group { margin-bottom: var(--spacing-lg); }
    .form-label { display: block; font-weight: 600; margin-bottom: 6px; font-size: 0.9rem; }
    .form-control {
      width: 100%;
      padding: 10px 12px;
      border: 1px solid var(--border-color);
      border-radius: var(--border-radius);
      font-size: 0.95rem;
      box-sizing: border-box;
      background: var(--bg-secondary, #fff);
      color: var(--text-primary);
    }
    .form-control:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(0,102,204,0.1);
    }

    textarea.form-control {
      font-family: 'Courier New', monospace;
      font-size: 0.85rem;
      min-height: 200px;
      resize: vertical;
      line-height: 1.5;
    }

    .variable-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: 6px;
    }

    .variable-chip {
      background: #e0f2fe;
      color: #0369a1;
      padding: 2px 8px;
      border-radius: 10px;
      font-size: 0.8rem;
      font-family: monospace;
      cursor: pointer;
      transition: background 0.15s;
      user-select: none;
    }

    .variable-chip:hover { background: #bae6fd; }

    .tabs { display: flex; gap: 0; border-bottom: 2px solid var(--border-color); margin-bottom: var(--spacing-lg); }
    .tab-btn {
      padding: 8px 18px;
      border: none;
      background: none;
      cursor: pointer;
      font-weight: 500;
      color: var(--text-secondary);
      border-bottom: 2px solid transparent;
      margin-bottom: -2px;
      transition: color 0.15s, border-color 0.15s;
    }
    .tab-btn.active { color: var(--primary); border-bottom-color: var(--primary); }

    .tab-content { display: none; }
    .tab-content.active { display: block; }

    .preview-box {
      background: var(--bg-light);
      border: 1px solid var(--border-color);
      border-radius: var(--border-radius);
      padding: var(--spacing-lg);
      min-height: 150px;
      white-space: pre-wrap;
      font-size: 0.9rem;
      font-family: inherit;
      line-height: 1.6;
    }

    .btn {
      padding: 9px 18px;
      border: none;
      border-radius: var(--border-radius);
      cursor: pointer;
      font-weight: 600;
      font-size: 0.9rem;
      transition: opacity 0.2s;
    }
    .btn:hover { opacity: 0.85; }
    .btn:disabled { opacity: 0.5; cursor: not-allowed; }
    .btn-primary { background: linear-gradient(135deg, var(--primary), #0066cc); color: white; }
    .btn-secondary { background: var(--bg-light); color: var(--text-primary); border: 1px solid var(--border-color); }
    .btn-danger { background: #ef4444; color: white; }
    .btn-sm { padding: 5px 12px; font-size: 0.8rem; }

    .toggle-switch {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      cursor: pointer;
    }
    .toggle-switch input { display: none; }
    .toggle-track {
      width: 40px; height: 22px;
      background: #d1d5db;
      border-radius: 11px;
      position: relative;
      transition: background 0.2s;
    }
    .toggle-switch input:checked + .toggle-track { background: #059669; }
    .toggle-track::after {
      content: '';
      position: absolute;
      top: 3px; left: 3px;
      width: 16px; height: 16px;
      background: white;
      border-radius: 50%;
      transition: left 0.2s;
    }
    .toggle-switch input:checked + .toggle-track::after { left: 21px; }

    .alert { padding: var(--spacing-md) var(--spacing-lg); border-radius: var(--border-radius); margin-bottom: var(--spacing-lg); }
    .alert-success { background: #d1fae5; color: #065f46; border-left: 4px solid #10b981; }
    .alert-error { background: #fee2e2; color: #991b1b; border-left: 4px solid #ef4444; }
  </style>
</head>
<body>
  <div class="app-container">
    <%- include('../partials/navigation', { user, currentPage: 'admin-message-templates' }) %>

    <main class="main-content">
      <header class="header">
        <div class="header-left">
          <button class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Toggle menu">
            <i class="fas fa-bars"></i>
          </button>
          <h1 class="header-title">Message Templates</h1>
        </div>
      </header>

      <div class="page-content">
        <div id="alertContainer"></div>

        <div class="templates-layout">
          <!-- Template list sidebar -->
          <div class="template-list">
            <div class="template-list-header">Templates</div>
            <div id="templateListItems">
              <div style="padding: var(--spacing-lg); text-align: center; color: var(--text-secondary);">
                <div class="spinner" style="width:24px;height:24px;border-width:3px;margin:0 auto 8px;"></div>
                Loading…
              </div>
            </div>
          </div>

          <!-- Editor panel -->
          <div id="editorPanel" class="editor-panel empty-state">
            <i class="fas fa-envelope-open-text"></i>
            <p>Select a template to edit</p>
          </div>
        </div>
      </div>
    </main>
  </div>

  <style>
    @keyframes spin { to { transform: rotate(360deg); } }
    .spinner { border: 3px solid var(--border-color); border-top-color: var(--primary); border-radius: 50%; animation: spin 0.8s linear infinite; }
  </style>

  <script src="/js/admin-message-templates.js"></script>

  <script src="/js/mobile-nav.js"></script>
</body>
</html>
